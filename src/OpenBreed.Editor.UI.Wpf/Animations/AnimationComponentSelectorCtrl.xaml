<UserControl x:Class="OpenBreed.Editor.UI.Wpf.Animations.AnimationComponentSelectorCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenBreed.Editor.UI.Wpf.Animations"
             xmlns:converters="clr-namespace:OpenBreed.Editor.UI.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../CommonResources.xaml"/>
                <ResourceDictionary>
                    <converters:EventArgsConverter x:Key="eventArgsConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="75"/>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="75"/>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Content="Component" Grid.ColumnSpan="2"/>
        <ComboBox Grid.Column="1"
                  Style="{StaticResource CommonComboBoxStyle}"
                  ItemsSource="{Binding ComponentNames}"
                  SelectedItem="{Binding SelectedComponentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Label Grid.Column="2" Content="Property"/>
        <ComboBox Grid.Column="3"
                  Style="{StaticResource CommonComboBoxStyle}"
                  ItemsSource="{Binding ComponentPropertyNames}"
                  SelectedItem="{Binding SelectedComponentPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Column="4"
                    Style="{StaticResource ConfirmButtonStyle}"
                    ToolTip="Confirms new track creation."
                    IsEnabled="{Binding IsConfirmEnabled}" 
                    Command="{Binding ConfirmCommand}">
            <Image/>
        </Button>
        <Button Grid.Column="5"
                    Style="{StaticResource CancelButtonStyle}"
                    ToolTip="Cancels new track creation."
                    Command="{Binding CancelCommand}">
            <Image/>
        </Button>
    </Grid>
</UserControl>
