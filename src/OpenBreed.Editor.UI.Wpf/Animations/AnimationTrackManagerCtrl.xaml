<UserControl x:Class="OpenBreed.Editor.UI.Wpf.Animations.AnimationTrackManagerCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenBreed.Editor.UI.Wpf.Animations"
             xmlns:converters="clr-namespace:OpenBreed.Editor.UI.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../CommonResources.xaml"/>
                <ResourceDictionary>
                    <converters:EventArgsConverter x:Key="eventArgsConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Grid.Row="2"
              Grid.RowSpan="1"
              Grid.Column="0"
              Grid.ColumnSpan="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <GroupBox Header="Tracks" Grid.Row="0" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                    Style="{StaticResource AddButtonStyle}"
                    ToolTip="Adds new track."
                    IsEnabled="{Binding IsAddTrackModeEnabled}"
                    Command="{Binding AddNewTrackCommand}">
                            <Image/>
                        </Button>
                        <Button Grid.Column="3"
                    IsEnabled="{Binding IsAddTrackModeEnabled}"       
                    Style="{StaticResource RemoveButtonStyle}"
                    ToolTip="Removes selected track."
                    Command="{Binding RemoveTrackCommand}">
                            <Image/>
                        </Button>
                    </Grid>
                    <local:AnimationComponentSelectorCtrl DataContext="{Binding ComponentSelector}" Visibility="{Binding IsVisible, Converter={StaticResource VisibleIfTrueConverter}}" />
                </StackPanel>
                <ListView Grid.Row="1"
                        ItemsSource="{Binding TrackItems}"
                        SelectedItem="{Binding SelectedTrack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <WrapPanel Width="560">
                                <TextBlock Text="{Binding Label}"
                                           TextWrapping="Wrap">
                                </TextBlock>
                            </WrapPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
