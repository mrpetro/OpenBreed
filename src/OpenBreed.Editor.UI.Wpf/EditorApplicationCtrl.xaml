<UserControl xmlns:Logging="clr-namespace:OpenBreed.Editor.UI.Wpf.Logging"  xmlns:General="clr-namespace:OpenBreed.Editor.UI.Wpf.General"
             x:Class="OpenBreed.Editor.UI.Wpf.EditorApplicationCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OpenBreed.Editor.UI.Wpf"
             xmlns:databaseVm="clr-namespace:OpenBreed.Editor.VM.Database;assembly=OpenBreed.Editor.VM"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrueConverter" />
        <DataTemplate DataType="{x:Type databaseVm:DbEditorVM}">
            <General:DbEditorCtrl Background="White"/>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" ItemsSource="{Binding Menus}">
            <Menu.ItemContainerStyle>
                <Style TargetType="MenuItem">

                    <Setter Property="Header"
                    Value="{Binding Header}" />

                    <Setter Property="Command"
                    Value="{Binding Command}" />

                    <Setter Property="IsEnabled"
                    Value="{Binding IsEnabled}" />

                    <Setter Property="ItemsSource"
                    Value="{Binding Menus}" />

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding IsSeparator}"
                             Value="True">

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Separator />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Setter Property="Focusable"
                            Value="False" />

                            <Setter Property="IsHitTestVisible"
                            Value="False" />

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </Menu.ItemContainerStyle>
        </Menu>
        <Grid Grid.Row="1" Background="#8B8B8B">
            <ContentControl  
                        Content="{Binding CurrentView}" >
            </ContentControl>
        </Grid>
        <Expander Grid.Row="3"
                  ExpandDirection="Down"
                  Header="Logs">
            <Logging:LoggingCtrl DataContext="{Binding Logger}" MaxHeight="200" />
        </Expander>
    </Grid>
</UserControl>
